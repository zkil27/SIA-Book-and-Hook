# Copy to .env.local and fill in. Never commit .env.local.
# Both database URLs are required. See docs/deployment.md.

# Supabase POOLED connection — port 6543, with ?pgbouncer=true
# Used by the app at runtime. connect_timeout / pool_timeout (seconds) make a
# paused or unreachable database fail fast, so the storefront falls back to
# the offline catalog quickly instead of hanging.
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connect_timeout=5&pool_timeout=10"

# Supabase DIRECT connection — port 5432
# Used by prisma migrate only. Migrations cannot run through the pooler.
DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# http://localhost:3000 locally; the deployed URL in production
NEXTAUTH_URL="http://localhost:3000"

# Developer tools (/admin/dev). Comma-separated emails of ADMIN accounts that
# may open it. Empty or unset = the section is off for everyone (404).
# Create your own dev admin with: npm run dev:admin (see docs/dev-tools.md).
DEV_EMAILS=""

# Optional: print every SQL statement Prisma sends (performance work only).
# PRISMA_LOG="query"
