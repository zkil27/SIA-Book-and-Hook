#!/bin/sh
#
# Universal pre-commit gate for Hook & Box.
#
# Runs the same `npm run verify` (typecheck + lint + footgun scan) that any tool
# or CI runs, so a commit can't introduce a type error, lint failure, or a known
# project footgun (stray PrismaClient, float money, catalog hard-delete, ledger
# mutation). This is committed to the repo and activated via `core.hooksPath`
# (see `npm run setup:hooks` / postinstall) — no husky, works on any OS.
#
# Bypass in a genuine emergency with:  git commit --no-verify
# (Prefer fixing the issue; a bypassed commit still fails in CI.)

echo "[pre-commit] running npm run verify ..."

node_major=$(node -p "process.versions.node.split('.')[0]" 2>/dev/null)
if [ -z "$node_major" ] || [ "$node_major" -lt 20 ]; then
  echo ""
  echo "[pre-commit] Node.js 20.9+ is required by Next.js 16."
  echo "[pre-commit] Current Node.js: $(node --version 2>/dev/null || echo 'not found')"
  echo "[pre-commit] Start VS Code from a Node 20+ terminal, then retry the commit."
  echo "[pre-commit] On Windows, verify with: node --version"
  exit 1
fi

npm run verify
status=$?

if [ $status -ne 0 ]; then
  echo ""
  echo "[pre-commit] verify failed (exit $status). Commit aborted."
  echo "[pre-commit] Fix the issues above, or bypass with 'git commit --no-verify' (not recommended)."
  exit 1
fi

echo "[pre-commit] verify passed."
exit 0
