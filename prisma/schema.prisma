datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider        = "prisma-client-js"
  // Nested reads (order → items → variant → product) load in one SQL
  // statement when a query passes relationLoadStrategy: "join".
  previewFeatures = ["relationJoins"]
}

enum Role {
  CUSTOMER
  ADMIN
  PACKER // packs confirmed orders and loads the truck; no admin access
  DRIVER // runs delivery trips; no admin access
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PACKED // packed and waiting for the truck
  READY // on the truck (a trip that has left the stall)
  COMPLETED
  CANCELLED
}

// A delivery trip: one vehicle and driver running one morning slot's stops.
enum TripStatus {
  PLANNED // drafted by the office, being loaded
  OUT // left the stall
  RETURNED // back at the stall, cash not yet confirmed
  REMITTED // the office confirmed the cash handed in
}

enum PaymentMethod {
  GCASH
  COD
}

model User {
  id             String             @id @default(cuid())
  name           String?
  email          String             @unique
  passwordHash   String
  role           Role               @default(CUSTOMER)
  // Saved delivery details: prefill checkout. Orders keep their own snapshot.
  phone          String?
  address        String?
  barangay       String?
  orders         Order[]            @relation("CustomerOrders")
  stockMovements StockMovement[] // movements this staff member recorded
  statusEvents   OrderStatusEvent[] // status changes this staff member made
  trips          Trip[]             @relation("DriverTrips") // trips this driver ran
  remitsTaken    Trip[]             @relation("RemitConfirmations") // trip cash this admin confirmed
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
}

model Category {
  id       String    @id @default(cuid())
  name     String
  slug     String    @unique
  products Product[]
}

model Product {
  id          String           @id @default(cuid())
  name        String
  description String?
  imageUrl    String? // Static path under /public (no uploads), e.g. "/products/bangus.jpg"
  categoryId  String
  category    Category         @relation(fields: [categoryId], references: [id])
  active      Boolean          @default(true) // Soft-delete
  variants    ProductVariant[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([categoryId]) // Postgres doesn't index foreign keys on its own
}

model ProductVariant {
  id             String          @id @default(cuid())
  productId      String
  product        Product         @relation(fields: [productId], references: [id])
  name           String // e.g., "500g", "Whole"
  sku            String          @unique
  priceCentavos  Int // Stored as Int centavos
  priceUpdatedAt DateTime? // Last price change; drives the "changed today" flag
  active         Boolean         @default(true) // Soft-delete a single variant
  stockMovements StockMovement[]
  orderItems     OrderItem[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([productId])
}

model StockMovement {
  id        String         @id @default(cuid())
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  quantity  Int // Positive for additions, negative for reductions
  reason    String // e.g., "Sale — HB-0005", "Spoilage", "Restock"
  orderId   String? // Set when an order caused the movement
  order     Order?         @relation(fields: [orderId], references: [id])
  actorId   String? // Staff member who recorded it (null for system/seed)
  actor     User?          @relation(fields: [actorId], references: [id])
  createdAt DateTime       @default(now()) // Append-only ledger

  @@index([variantId, createdAt])
  @@index([variantId, quantity]) // covering index: stock = SUM(quantity) per variant, read from the index alone
  @@index([orderId]) // an order's movements (cancel returns exactly what it holds)
}

model Order {
  id                  String             @id @default(cuid())
  orderNumber         Int                @unique @default(autoincrement()) // Shown as "HB-0005"
  customerId          String
  customer            User               @relation("CustomerOrders", fields: [customerId], references: [id])
  status              OrderStatus        @default(PENDING)
  paymentMethod       PaymentMethod
  deliveryName        String
  deliveryPhone       String
  deliveryAddress     String
  deliveryBarangay    String
  deliverySlot        String // e.g. "6:00–8:00 AM"
  deliveryDate        DateTime?          @db.Date // Manila calendar day of the slot; null only on very old rows
  deliveryFeeCentavos Int                @default(0)
  totalCentavos       Int // Items + delivery fee, in centavos
  items               OrderItem[]
  statusEvents        OrderStatusEvent[]
  stockMovements      StockMovement[]
  tripId              String? // the trip carrying it (set while planned, kept once delivered)
  trip                Trip?              @relation(fields: [tripId], references: [id])
  stopIndex           Int? // position on the trip's route, 1 = first stop
  loadedAt            DateTime? // ticked onto the truck during loading
  handoffPin          String? // 4 digits shown only to the customer; the driver enters it at the door
  pinAttempts         Int                @default(0) // wrong PIN entries; 5 locks the PIN
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([status, createdAt]) // admin tabs, dashboard, pending counts
  @@index([createdAt]) // the "All" tab and week totals, which span every status
  @@index([customerId, createdAt]) // a customer's order history
  @@index([deliveryDate, deliverySlot, status]) // slot capacity and dispatch drafting
  @@index([tripId, stopIndex]) // a trip's stops in route order
}

model Trip {
  id                   String     @id @default(cuid())
  tripNumber           Int        @unique @default(autoincrement()) // Shown as "T-012"
  date                 DateTime   @db.Date // delivery day (Manila)
  slot                 String // one of DELIVERY_SLOTS
  vehicle              String // label only, e.g. "Truck 1"
  status               TripStatus @default(PLANNED)
  driverId             String?
  driver               User?      @relation("DriverTrips", fields: [driverId], references: [id])
  departedAt           DateTime?
  returnedAt           DateTime?
  cashRemittedCentavos Int? // COD cash the office counted on return
  remitNote            String? // required when the cash doesn't match
  remitConfirmedById   String?
  remitConfirmedBy     User?      @relation("RemitConfirmations", fields: [remitConfirmedById], references: [id])
  remittedAt           DateTime?
  orders               Order[]
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  @@index([date, slot])
  @@index([driverId, date])
  @@index([status])
}

model OrderItem {
  id          String         @id @default(cuid())
  orderId     String
  order       Order          @relation(fields: [orderId], references: [id])
  variantId   String
  variant     ProductVariant @relation(fields: [variantId], references: [id])
  quantity    Int
  priceAtTime Int // Captured price in centavos at time of order

  @@index([orderId])
  @@index([variantId])
}

// Append-only order timeline: one row per status change. Never edited/deleted.
model OrderStatusEvent {
  id         String       @id @default(cuid())
  orderId    String
  order      Order        @relation(fields: [orderId], references: [id])
  fromStatus OrderStatus? // null for the creation event
  toStatus   OrderStatus
  note       String? // e.g. cancellation reason
  actorId    String?
  actor      User?        @relation(fields: [actorId], references: [id])
  createdAt  DateTime     @default(now())

  @@index([orderId, createdAt])
  @@index([toStatus, createdAt]) // dashboard "delivered without a PIN" and delivery times
}
